# Client-side Supabase configuration (inlined at build time)
VITE_SUPABASE_PROJECT_ID=example-project-ref
VITE_SUPABASE_URL=https://example-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Server-side Supabase configuration
SUPABASE_PROJECT_ID=example-project-ref
SUPABASE_URL=https://example-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SERVICE_ROLE_KEY=sb_secret_placeholder

# Scheduled cron endpoint guard (/api/public/ingest, /api/public/apollo-sync-accounts)
CRON_SECRET=replace-with-random-secret

# Optional external enrichment and connector keys
APOLLO_API_KEY=
APOLLO_DAILY_CAP=150
SAM_GOV_API_KEY=
LOVABLE_API_KEY=
HUBSPOT_API_KEY=
GOOGLE_MAIL_API_KEY=

# Google Cloud Direct Copilot & LLM Configuration
# Set either your Google Cloud API key (Gemini / Generative AI) or a custom Google Cloud endpoint URL
GOOGLE_CLOUD_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLOUD_API_URL=
COPILOT_API_URL=
GOOGLE_CLOUD_MODEL=gemini-2.5-flash
